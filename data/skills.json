      "accept": [
        "2,3",
        "x=2 or x=3",
        "3,2"
      ]
    },
    {
      "id": "quadratics-2",
      "prompt": "Find the discriminant of $2x^{2}+3x+4$.",
      "answer": "$-23$",
      "solution": "$b^{2}-4ac=9-32=-23$. No real roots.",
