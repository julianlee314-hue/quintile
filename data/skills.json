  "items": [
    {
      "id": "indices-1",
      "prompt": "Simplify $\\dfrac{2^{3}\\times 2^{4}}{2^{5}}$.",
      "answer": "$4$",
      "solution": "Add the indices in the product, then subtract: $2^{3+4-5}=2^{2}=4$.",
      "accept": [
        "4",
        "2^2"
      ]
    },
    {
      "id": "indices-2",
      "prompt": "Simplify $\\dfrac{(x^{5})^{2}}{x^{4}}$.",
      "answer": "$x^{6}$",
      "solution": "$(x^{5})^{2}=x^{10}$, then $x^{10}/x^{4}=x^{6}$.",
      "accept": [
        "x^6"
      ]
    },
    {
      "id": "indices-3",
      "prompt": "Write $\\sqrt{48}$ in simplest surd form.",
      "answer": "$4\\sqrt{3}$",
      "solution": "$48=16\\times 3$, so $\\sqrt{48}=4\\sqrt{3}$.",
      "accept": [
        "4sqrt(3)",
        "4*sqrt(3)"
      ]
    },
    {
      "id": "indices-4",
      "prompt": "Rationalise $\\dfrac{1}{\\sqrt{2}}$.",
      "answer": "$\\dfrac{\\sqrt{2}}{2}$",
      "solution": "Multiply numerator and denominator by $\\sqrt{2}$.",
      "accept": [
        "sqrt(2)/2",
        "1/sqrt(2)"
      ]
    },
    {
      "id": "indices-5",
      "prompt": "Evaluate $8^{2/3}$.",
      "answer": "$4$",
      "solution": "$8^{1/3}=2$ and $2^{2}=4$.",
      "accept": [
        "4"
      ]
    },
    {
      "id": "manipulation-1",
      "prompt": "Expand $(x-3)(x+4)$.",
      "answer": "$x^{2}+x-12$",
      "solution": "$x^{2}+4x-3x-12=x^{2}+x-12$.",
      "accept": [
        "x^2+x-12",
        "x^2-12+x"
      ]
    },
    {
      "id": "manipulation-2",
      "prompt": "Factorise $x^{2}-5x+6$.",
      "answer": "$(x-2)(x-3)$",
      "solution": "Look for two numbers multiplying to $6$ and adding to $-5$: $-2$ and $-3$.",
      "accept": [
        "(x-2)(x-3)",
        "(x-3)(x-2)"
      ]
    },
    {
      "id": "manipulation-3",
      "prompt": "Simplify $\\dfrac{x^{2}-9}{x-3}$, for $x\\neq 3$.",
      "answer": "$x+3$",
      "solution": "$x^{2}-9=(x-3)(x+3)$, so the factor $x-3$ cancels.",
      "accept": [
        "x+3",
        "3+x"
      ]
    },
    {
      "id": "manipulation-4",
      "prompt": "Solve $\\dfrac{2x+1}{3}=5$.",
      "answer": "$x=7$",
      "solution": "$2x+1=15$, so $2x=14$ and $x=7$.",
      "accept": [
        "7",
        "x=7"
      ]
    },
    {
      "id": "manipulation-5",
      "prompt": "Expand $(2x-1)^{2}$.",
      "answer": "$4x^{2}-4x+1$",
      "solution": "$(2x-1)^{2}=4x^{2}-2\\cdot 2x\\cdot 1+1$.",
      "accept": [
        "4x^2-4x+1"
      ]
    },
    {
      "id": "linear-1",
      "prompt": "Solve $3x-7=11$.",
      "answer": "$x=6$",
      "solution": "$3x=18$, so $x=6$.",
      "accept": [
        "6",
        "x=6"
      ]
    },
    {
      "id": "linear-2",
      "prompt": "Solve $2(x-4)=x+1$.",
      "answer": "$x=9$",
      "solution": "$2x-8=x+1$, so $x=9$.",
      "accept": [
        "9",
        "x=9"
      ]
    },
    {
      "id": "linear-3",
      "prompt": "Solve the inequality $4x+1<13$.",
      "answer": "$x<3$",
      "solution": "$4x<12$, so $x<3$.",
      "accept": [
        "x<3",
        "<3"
      ]
    },
    {
      "id": "linear-4",
      "prompt": "The line through $(1,2)$ and $(3,8)$ has equation $y=mx+c$. Find $m$.",
      "answer": "$3$",
      "solution": "$m=(8-2)/(3-1)=3$.",
      "accept": [
        "3",
        "m=3"
      ]
    },
    {
      "id": "linear-5",
      "prompt": "Solve the system $x+y=10$, $x-y=2$. Give $x$ and $y$.",
      "answer": "$x=6$, $y=4$",
      "solution": "Adding the equations gives $2x=12$. Then $y=4$.",
      "accept": [
        "x=6,y=4",
        "6,4",
        "(6,4)"
      ]
    },
    {
      "id": "quadratics-1",
      "prompt": "Solve $x^{2}-5x+6=0$.",
      "answer": "$x=2$ or $x=3$",
