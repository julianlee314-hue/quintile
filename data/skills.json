      "accept": [
        "(x+3)^2-7",
        "(x+3)^2+(-7)"
      ]
    },
    {
      "id": "quadratics-4",
      "prompt": "Write down the vertex of $y=(x-2)^{2}+5$.",
      "answer": "$(2,5)$",
