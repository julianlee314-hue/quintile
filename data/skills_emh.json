[
  {
    "id": "indices",
    "order": 1,
    "title": "Indices & surds",
    "blurb": "Powers, roots, and rationalising a denominator.",
    "hlLink": "You need this before logs, binomial expansions, and exact trig values.",
    "items": [
      {
        "id": "indices-1",
        "stage": "easy",
        "difficulty": 1,
        "prompt": "Simplify $\\dfrac{2^{3}\\times 2^{4}}{2^{5}}$.",
        "answer": "$4$",
        "solution": "Add the indices in the product, then subtract: $2^{3+4-5}=2^{2}=4$.",
        "accept": [
          "4",
          "2^2"
        ]
      },
      {
        "id": "indices-4",
        "stage": "easy",
        "difficulty": 1,
        "prompt": "Rationalise $\\dfrac{1}{\\sqrt{2}}$.",
        "answer": "$\\dfrac{\\sqrt{2}}{2}$",
        "solution": "Multiply numerator and denominator by $\\sqrt{2}$.",
        "accept": [
          "sqrt(2)/2",
          "1/sqrt(2)"
        ]
      },
      {
        "id": "indices-e3",
        "stage": "easy",
        "difficulty": 1,
        "prompt": "Simplify $5^{0}$.",
        "answer": "$1$",
        "solution": "Any non-zero number to the power $0$ is $1$.",
        "accept": [
          "1"
        ]
      },
      {
        "id": "indices-e4",
        "stage": "easy",
        "difficulty": 1,
        "prompt": "Simplify $3^{-2}$.",
        "answer": "$\\dfrac{1}{9}$",
        "solution": "$3^{-2}=\\dfrac{1}{3^{2}}=\\dfrac{1}{9}$.",
        "accept": [
          "1/9"
        ]
      },
      {
        "id": "indices-e5",
        "stage": "easy",
        "difficulty": 1,
        "prompt": "Simplify $\\sqrt{36}$.",
        "answer": "$6$",
        "solution": "$6^{2}=36$.",
        "accept": [
          "6"
        ]
      },
      {
        "id": "indices-2",
        "stage": "medium",
        "difficulty": 2,
        "prompt": "Simplify $\\dfrac{(x^{5})^{2}}{x^{4}}$.",
        "answer": "$x^{6}$",
        "solution": "$(x^{5})^{2}=x^{10}$, then $x^{10}/x^{4}=x^{6}$.",
        "accept": [
          "x^6"
        ]
      },
      {
        "id": "indices-3",
        "stage": "medium",
        "difficulty": 2,
        "prompt": "Write $\\sqrt{48}$ in simplest surd form.",
        "answer": "$4\\sqrt{3}$",
        "solution": "$48=16\\times 3$, so $\\sqrt{48}=4\\sqrt{3}$.",
        "accept": [
          "4sqrt(3)",
          "4*sqrt(3)"
        ]
      },
      {
        "id": "indices-5",
        "stage": "medium",
        "difficulty": 2,
        "prompt": "Evaluate $8^{2/3}$.",
        "answer": "$4$",
        "solution": "$8^{1/3}=2$ and $2^{2}=4$.",
        "accept": [
          "4"
        ]
      },
      {
        "id": "indices-m4",
        "stage": "medium",
        "difficulty": 2,
        "prompt": "Simplify $\\dfrac{a^{7}}{a^{2}\\cdot a^{3}}$.",
        "answer": "$a^{2}$",
        "solution": "$a^{2}\\cdot a^{3}=a^{5}$, so $a^{7}/a^{5}=a^{2}$.",
        "accept": [
          "a^2"
        ]
      },
      {
        "id": "indices-m5",
        "stage": "medium",
        "difficulty": 2,
        "prompt": "Rationalise $\\dfrac{6}{\\sqrt{3}}$.",
        "answer": "$2\\sqrt{3}$",
        "solution": "$\\dfrac{6}{\\sqrt{3}}\\cdot\\dfrac{\\sqrt{3}}{\\sqrt{3}}=\\dfrac{6\\sqrt{3}}{3}=2\\sqrt{3}$.",
        "accept": [
          "2sqrt(3)",
          "2*sqrt(3)"
        ]
      },
      {
        "id": "indices-h1",
        "stage": "hard",
        "difficulty": 3,
        "prompt": "Simplify $\\dfrac{(2x^{3})^{4}}{4x^{5}}$.",
        "answer": "$4x^{7}$",
        "solution": "$(2x^{3})^{4}=16x^{12}$, then $16x^{12}/(4x^{5})=4x^{7}$.",
        "accept": [
          "4x^7"
        ]
      },
      {
        "id": "indices-h2",
        "stage": "hard",
        "difficulty": 3,
        "prompt": "Write $\\dfrac{\\sqrt{50}}{\\sqrt{2}}$ in simplest form.",
        "answer": "$5$",
        "solution": "$\\sqrt{50}/\\sqrt{2}=\\sqrt{25}=5$.",
        "accept": [
          "5"
        ]
      },
      {
        "id": "indices-h3",
        "stage": "hard",
        "difficulty": 3,
        "prompt": "Rationalise $\\dfrac{1}{2+\\sqrt{3}}$.",
        "answer": "$2-\\sqrt{3}$",
        "solution": "Multiply by $2-\\sqrt{3}$: numerator $2-\\sqrt{3}$, denominator $4-3=1$.",
        "accept": [
          "2-sqrt(3)"
        ]
      },
      {
        "id": "indices-h4",
        "stage": "hard",
        "difficulty": 3,
        "prompt": "Simplify $\\left(\\dfrac{27}{8}\\right)^{-2/3}$.",
        "answer": "$\\dfrac{4}{9}$",
        "solution": "$\\left(\\dfrac{8}{27}\\right)^{2/3}=\\dfrac{4}{9}$.",
        "accept": [
          "4/9"
        ]
      },
      {
        "id": "indices-h5",
        "stage": "hard",
        "difficulty": 3,
        "prompt": "Simplify $\\dfrac{x^{-2}y^{3}}{x^{3}y^{-1}}$.",
        "answer": "$\\dfrac{y^{4}}{x^{5}}$",
        "solution": "$x^{-2-3}y^{3-(-1)}=x^{-5}y^{4}=\\dfrac{y^{4}}{x^{5}}$.",
        "accept": [
          "y^4/x^5",
          "(y^4)/(x^5)"
        ]
      }
    ]
  },
  {
    "id": "manipulation",
